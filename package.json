{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && eslint . && oxlint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" server.ts vite.config.ts eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" server.ts vite.config.ts eslint.config.js",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"server/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=78 --test-coverage-functions=78 --test-coverage-exclude=\"src/**/*.test.*\" --test-coverage-exclude=\"server/*.test.*\" \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"server/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
